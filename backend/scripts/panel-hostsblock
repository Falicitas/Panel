#!/bin/bash
# panel-hostsblock — 管理 /etc/hosts 里 panel 专属的拦截标记块 (root 执行)。
#
# 用法:
#   panel-hostsblock block <domain...>   重写标记块: 每域名两行 (0.0.0.0 + ::)
#   panel-hostsblock unblock             删除标记块
#
# 标记块外的内容原样保留; block 重复执行是幂等替换 (不叠加)。
# 改完自动 flush DNS 缓存。
#
# 安装 (一次性; 必须 root 拥有且他人不可写, 否则 sudoers 授权等于任意提权):
#   sudo install -o root -g wheel -m 755 \
#     backend/scripts/panel-hostsblock /usr/local/bin/
#   sudoers 单行: kinesis ALL=(root) NOPASSWD: /usr/local/bin/panel-hostsblock
#
# 测试钩子: 设 PANEL_HOSTS 指向替身文件 → 不需要 root, 且跳过 DNS flush。
set -euo pipefail

HOSTS="${PANEL_HOSTS:-/etc/hosts}"
BEGIN="# >>> panel-hostsblock >>>"
END="# <<< panel-hostsblock <<<"

# strip: 输出去掉标记块后的现有内容
strip() {
  awk -v b="$BEGIN" -v e="$END" '$0==b{skip=1} !skip{print} $0==e{skip=0}' "$HOSTS"
}

# replace: 从 stdin 读新全文, 同目录 tmp + mv 原子替换, 保持 0644
replace() {
  local tmp
  tmp=$(mktemp "${HOSTS}.panel.XXXXXX")
  cat > "$tmp"
  chmod 644 "$tmp"
  mv -f "$tmp" "$HOSTS"
}

flush_dns() {
  [ -n "${PANEL_HOSTS:-}" ] && return 0
  dscacheutil -flushcache || true
  killall -HUP mDNSResponder 2>/dev/null || true
}

case "${1:-}" in
  block)
    shift
    [ "$#" -ge 1 ] || { echo "usage: panel-hostsblock block <domain...>" >&2; exit 2; }
    for d in "$@"; do
      [[ "$d" =~ ^[A-Za-z0-9.-]+$ ]] || { echo "bad domain: $d" >&2; exit 2; }
    done
    {
      strip
      echo "$BEGIN"
      for d in "$@"; do printf '0.0.0.0 %s\n:: %s\n' "$d" "$d"; done
      echo "$END"
    } | replace
    flush_dns
    ;;
  unblock)
    strip | replace
    flush_dns
    ;;
  *)
    echo "usage: panel-hostsblock block <domain...> | unblock" >&2
    exit 2
    ;;
esac
